#!/usr/bin/env bash
# Installs nginx and adds a 301 redirect from /redirect_me
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
  sed -i '/server_name _;/a location /redirect_me {\nreturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n}' /etc/nginx/sites-available/default
fi
service nginx restart
